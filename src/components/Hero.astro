---
const { title, text, bgImg } = Astro.props;
---

<section class="hero">
  <div class="text-box">
    <h1>{title}</h1>
    <h3>{text}</h3>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 95vh;
    background-image: url(../../assets/heroimg1.webp);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .text-box {
    position: absolute;
    left: 5%;
    bottom: 10%;
    font-weight: 800;
    color: var(--color-white);
    width: fit-content;
    height: fit-content;
    /* background: rgba(255, 255, 255, 0.03);
    border-radius: 2rem;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px); */
  }

  h1 {
    color: var(--color-white);
    font-size: 4rem;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.6);
  }

  h3 {
    color: var(--color-white);
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 800px) {
    .hero {
      position: static;
      width: 100%;
      height: 70vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-size: cover;
    }

    .text-box {
      position: static;
      width: fit-content;
      height: fit-content;
      text-align: center;
    }
  @media (max-width: 500px) {
    .hero {
          background-image: url(../../assets/heroimg1mobil.webp);
        }
  }
  }
</style>
