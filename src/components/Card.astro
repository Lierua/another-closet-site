---
const { data } = Astro.props;
//console.log(data)
---

<div class="frame">
  <div class="overflow">
    {
      data.avaliable ? (
        ""
      ) : (
        <div class="black">
          <p class="udlant">Udlånt</p>
        </div>
      )
    }
    <a href=`/products/${data.slug}`>
      <img class="img" src={data.images[0]} alt="tøj fra Another Closet" />
    </a>
  </div>
  <a href=`/products/${data.slug}`>
    <div class="info">
      <h2 class="name">{data.name}</h2>
      <p>
        Størrelse: {data.size}
      </p>
      <p>
        Brand: {data.brand}
      </p>
    </div>
  </a>
  <p class="area">
    Lokation: <a class="color" href=`/areas/${data.areaslug}`>{data.area}</a>
  </p>
</div>

<style>
  .color {
    color: var(--color-red);
    transition: color 0.4s ease;
  }

  .color:hover {
    color: #e18282;
  }
  .overflow {
    position: relative;
    display: flex;
    width: 100%;
    height: 80%;
    align-items: center;
    overflow: hidden;
  }
  .black {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1;
    pointer-events: none;
  }
  .black p {
    position: absolute;
    transform: translate(-50%, -50%);
    top: 50%;
    left: 50%;
  }
  .frame {
    width: 230px;
    height: auto;
    aspect-ratio: 9/16;
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
  }
  .info {
    padding: 0.5rem 0 0 0.7rem;
    display: flex;
    flex-direction: column;
    margin-right: auto;
  }
  .area {
    margin-left: auto;
    padding: 0.7rem;
  }

  .img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: saturate(1);
    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .img:hover {
    transform: scale(1.1);
    filter: saturate(1.4);
  }

  .name {
    font-family: "Karla", sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 16px;
  }
  .udlant {
    font-family: "Karla", sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 30px;
    color: var(--color-white);
  }

  @media (max-width: 600px) {
    .frame {
      width: 45vw;
    }
  }
</style>
