---
const { title, subtitle, description, image } = Astro.props;
---

<section class="collection-section">
  <div class="content-wrapper">
    <div class="text-content">
      <h2>{title}</h2>
      <h3>{subtitle}</h3>
      <p>{description}</p>
    </div>
    <div class="image-content">
      <img src=`${image}` alt="acsplit3" />
    </div>
  </div>
</section>

<style>
  .collection-section {
    background-color: #2b2734;
    color: #ccffd3;
    margin-bottom: 2rem;
  }

  .content-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    gap: 5rem;
    flex-wrap: wrap;
  }

  .text-content {
    flex: 1;
    min-width: 300px;
  }

  .text-content h2 {
    font-size: 25px;
    font-weight: 500;
    margin-bottom: 1rem;
    color: #ccffd3;
    text-align: center;
    margin-left: 20%;
  }

  .text-content h3 {
    font-size: 16px;
    font-weight: 400;
    margin-bottom: 1.5rem;
    text-align: center;
    color: #ccffd3;
    margin-left: 20%;
  }

  .text-content p {
    font-size: 12px;
    line-height: 1.6;
    max-width: 500px;
    color: #ccffd3;
    text-align: center;
    margin-left: 20%;
  }

  .image-content {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-content img {
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: cover;
    border-radius: -0.5rem;
  }

  @media (max-width: 800px) {
    .collection-section {
      width: 100%;
      margin-bottom: 0px;
      padding-top: 25px;
    }
    .content-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      width: 100%;

      padding: 30px 10px;
      position: relative;
    }

    .text-content {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      transform: translate(-50%, -50%);
      background: rgba(42, 38, 47, 0.6);
      padding: 10px;
      z-index: 1;
    }
    .text-content h2 {
      margin-left: 0;
    }

    .text-content h3 {
      margin-left: 0;
    }

    .text-content p {
      margin-left: 0;
      max-width: 40ch;
    }
  }
</style>
